# WordPress Database Configuration
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wpuser
WORDPRESS_DB_PASSWORD=cambiami

# MySQL Root Password
MYSQL_ROOT_PASSWORD=cambiami

# Docker User Mapping (for proper file permissions)
# Run this on your system to get the values: id -u && id -g
# Or just use: DOCKER_UID=1000 DOCKER_GID=1000
DOCKER_UID=1000
DOCKER_GID=1000

# WordPress Security Keys
# In locale possono restare vuoti: WordPress genera salt casuali e li salva nel DB.
# In produzione salt e password li genera scripts/ruota-segreti.sh, solo nel .env del server.
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# Optional: Environment identifier
ENVIRONMENT=development

# WordPress Site URL Configuration
# For production, set this to your domain
# For development, leave empty or set to http://localhost:7000
WORDPRESS_CONFIG_EXTRA="define('WP_AUTO_UPDATE_CORE', false); define('AUTOMATIC_UPDATER_DISABLED', true);"

# Persistent data dirs (FUORI dal workspace del runner CI)
# In dev locale lasciale vuote: docker-compose.yml usa il fallback
#   ./wordpress/wp-content/uploads
# In produzione (dhpasteur): puntano alle dir create una tantum sul server
#AIUCD_UPLOADS_DIR=/home/dhpasteur/aiucd-data/uploads
#AIUCD_BACKUPS_DIR=/home/dhpasteur/aiucd-data/backups